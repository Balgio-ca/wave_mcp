# Copie ce fichier en .env si tu préfères garder la configuration hors du
# docker-compose. Toutes ces variables sont FACULTATIVES.

PORT=8099                     # port du service web
DATA_DIR=/app/data            # dossier persistant (registre, scènes, certificats)

BRAND_NAME="MANCAVE"                    # nom affiché (modifiable dans l'app)
TAGLINE="multi tv universal remote"      # sous-titre affiché

# --- Amorçage uniquement ---
# Utilisées SEULEMENT au premier démarrage, si data/devices.json n'existe pas :
# elles créent deux appareils de départ. Ensuite les appareils se gèrent dans
# l'interface (scan réseau ou ajout manuel) et ces variables sont ignorées.
SHIELD_HOST=192.168.0.70      # IP d'une Android TV / Shield
FIRETV_HOST=192.168.0.13      # IP d'une Fire TV
FIRETV_PORT=5555              # port ADB TCP
