# Copie ce fichier en .env si tu préfères garder les IP hors du docker-compose.
# (Le docker-compose actuel a les valeurs en dur ; ces variables les surchargent.)

SHIELD_HOST=192.168.0.xx      # IP de la Nvidia Shield Pro
FIRETV_HOST=192.168.0.xx      # IP de la TCL Fire TV
FIRETV_PORT=5555              # port ADB TCP de la Fire TV
PORT=8099                     # port du service web
DATA_DIR=/app/data            # dossier persistant (certificat Shield, intent mute)
